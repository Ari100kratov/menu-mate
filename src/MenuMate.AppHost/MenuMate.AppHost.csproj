<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.5.2" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <!-- Keep the package-based DCP/dashboard toolchain until Aspire CLI is provisioned in CI and developer environments. -->
    <AspireUseCliBundle>false</AspireUseCliBundle>
    <NoWarn>$(NoWarn);ASPIRE010</NoWarn>
    <UserSecretsId>34faaf39-df3b-4f91-9b88-1b723e1cece5</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting.AppHost" />
    <PackageReference Include="Aspire.Hosting.JavaScript" />
    <PackageReference Include="Aspire.Hosting.PostgreSQL" />
    <PackageReference Include="MessagePack" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\MenuMate.Api\MenuMate.Api.csproj" />
    <ProjectReference Include="..\MenuMate.Migrator\MenuMate.Migrator.csproj" />
  </ItemGroup>

</Project>
